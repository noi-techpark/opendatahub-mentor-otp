OTP_IMAGE="docker.io/opentripplanner/opentripplanner:2.11.0_2026-09-20T17-51"

CARSHARING_BASEURL=http://localhost:8091
AMARILLO_BASEURL=http://localhost:9095

# Note: the container expects ADMIN_TOKEN
ADMIN_TOKEN=secret
MATOMO_BASE_URL=https://digital.matomo.cloud/
MATOMO_SITE_ID=20

# Graph build. The Austrian Verbund feeds are behind a data.mobilitaetsverbuende.at login. The
# pipeline reads these from the environment and never stores them; without them the build fails.
MV_USERNAME=
MV_PASSWORD=

# Concurrent pipeline stages. Each EPIP conversion holds a heap in the tens of GB, so memory scales
# with this; lower it on a smaller box.
MAKE_JOBS=6

# Set to 0 to skip the OSM replication update. It rewrites the Europe extract in place and re-cuts
# the region, which rebuilds the street graph.
#OSM_UPDATE=0
